{
  "name": "real-estate-server",
  "version": "1.0.0",
  "description": "Backend for real estate listings",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts --watch src -e ts",
