    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.9",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.11",
